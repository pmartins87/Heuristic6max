WHEN (f$HLFlopRaiseCall AND f$HLTurnCheckRaiseCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2RM##
WHEN (f$HLFlopRaiseCall AND f$HLTurnBetRaisedCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2HB##
WHEN (f$HLFlopCheckRaiseCall AND f$HLTurnBetCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2HC##
WHEN (f$HLFlopCheckRaiseCall AND f$HLTurnCheckedThrough) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2HX##
WHEN (f$HLFlopCheckRaiseCall AND f$HLTurnCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2HR##
WHEN (f$HLFlopCheckRaiseCall AND f$HLTurnRaiseCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
