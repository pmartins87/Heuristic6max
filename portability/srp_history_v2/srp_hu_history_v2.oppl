WHEN (f$HLFlopCheckRaiseCall AND f$HLTurnCheckRaiseCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2HM##
WHEN (f$HLFlopCheckRaiseCall AND f$HLTurnBetRaisedCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2MB##
WHEN (f$HLFlopBetRaisedCall AND f$HLTurnBetCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2MC##
WHEN (f$HLFlopBetRaisedCall AND f$HLTurnCheckedThrough) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
##f$HLPath2MX##
WHEN (f$HLFlopBetRaisedCall AND f$HLTurnCall) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE
