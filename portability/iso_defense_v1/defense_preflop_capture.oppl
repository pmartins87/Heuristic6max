// ISODEF-1: opponent CO isolation into BTN (one previous limper), or BTN isolation into BB.
// No prior hero action. First orbit and no other caller. Exact BB pot is an unverified OH model.
// Explicit 'Set' tags mean intention only. Preserve frozen VS_OPEN and VS_3BET ranges untouched.
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InButton AND StillToAct = 2 AND FirstRaiserPosition = 3 AND LastRaiserPosition = 3 AND PotSize = 7 AND AmountToCall = 4.5 AND listH6DEF3BET) Set user_H6_DEF_BTN3
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InButton AND StillToAct = 2 AND FirstRaiserPosition = 3 AND LastRaiserPosition = 3 AND PotSize = 7 AND AmountToCall = 4.5 AND listH6DEF3BET) RaiseTo 13.5 FORCE
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InButton AND StillToAct = 2 AND FirstRaiserPosition = 3 AND LastRaiserPosition = 3 AND PotSize = 7 AND AmountToCall = 4.5 AND listH6DEFCALLBTN) Set user_H6_DEF_BTNC
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InButton AND StillToAct = 2 AND FirstRaiserPosition = 3 AND LastRaiserPosition = 3 AND PotSize = 7 AND AmountToCall = 4.5 AND listH6DEFCALLBTN) Call FORCE
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InButton AND StillToAct = 2 AND FirstRaiserPosition = 3 AND LastRaiserPosition = 3 AND PotSize = 7 AND AmountToCall = 4.5) Fold FORCE
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InBigBlind AND StillToAct = 0 AND FirstRaiserPosition = 2 AND LastRaiserPosition = 2 AND PotSize = 7 AND AmountToCall = 3.5 AND listH6DEF3BET) Set user_H6_DEF_BB3
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InBigBlind AND StillToAct = 0 AND FirstRaiserPosition = 2 AND LastRaiserPosition = 2 AND PotSize = 7 AND AmountToCall = 3.5 AND listH6DEF3BET) RaiseTo 15.75 FORCE
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InBigBlind AND StillToAct = 0 AND FirstRaiserPosition = 2 AND LastRaiserPosition = 2 AND PotSize = 7 AND AmountToCall = 3.5 AND listH6DEFCALLBB) Set user_H6_DEF_BBC
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InBigBlind AND StillToAct = 0 AND FirstRaiserPosition = 2 AND LastRaiserPosition = 2 AND PotSize = 7 AND AmountToCall = 3.5 AND listH6DEFCALLBB) Call FORCE
WHEN (IsPreflop AND nplayersdealt = 6 AND Raises = 1 AND Calls = 1 AND NOT StackUnknown AND StackSize >= 95 AND StackSize <= 105 AND MinOpponentStackSize >= 95 AND MaxOpponentStackSize <= 105 AND InBigBlind AND StillToAct = 0 AND FirstRaiserPosition = 2 AND LastRaiserPosition = 2 AND PotSize = 7 AND AmountToCall = 3.5) Fold FORCE
