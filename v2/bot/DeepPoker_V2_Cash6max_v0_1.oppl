// Decision classifications: hand rank > board texture; pot/history always contextual.
##f$DP_HeadsUp##
WHEN OpponentsLeft = 1 RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_Multiway##
WHEN OpponentsLeft > 1 RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_Premium##
WHEN HaveStraightFlush OR HaveQuads RETURN TRUE FORCE
WHEN HaveFullHouse AND NOT FullHouseOnBoard RETURN TRUE FORCE
WHEN HaveNuts AND NOT NutsOnBoard RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_StrongMade##
WHEN f$DP_Premium RETURN TRUE FORCE
WHEN (HaveFlush AND NOT FlushOnBoard) RETURN TRUE FORCE
WHEN (HaveStraight AND NOT StraightOnBoard) RETURN TRUE FORCE
WHEN HaveSet OR HaveTwoPair OR HaveTrips RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_GoodPair##
WHEN HaveOverPair OR HaveTopPair RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_WeakPair##
WHEN HaveSecondTopPair OR HaveBottomPair OR HaveUnderPair OR HaveThirdTopPair RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_NutDraw##
WHEN HaveNutFlushDraw OR HaveOpenEndedStraightDraw OR HaveDoubleGutshotDraw RETURN TRUE FORCE
WHEN HaveFlushDraw AND HaveStraightDraw RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_AnyDraw##
WHEN HaveFlushDraw OR HaveStraightDraw OR HaveInsideStraightDraw RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_Dangerous##
WHEN OneCardFlushPossible OR OneCardStraightPossible RETURN TRUE FORCE
WHEN (PairOnBoard AND FlushPossible) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_DynamicFlop##
WHEN FlushPossibleOnFlop OR StraightPossibleOnFlop OR TwoOfOneSuitPresentOnFlop RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_ValueProtected##
WHEN HaveStraightFlush OR HaveQuads OR HaveNuts RETURN TRUE FORCE
WHEN HaveFullHouse AND NOT FullHouseOnBoard RETURN TRUE FORCE
WHEN (HaveFlush AND NOT OneCardFlushPossible AND NOT FlushOnBoard) RETURN TRUE FORCE
WHEN (HaveStraight AND NOT PairOnBoard AND NOT FlushPossible AND NOT StraightOnBoard) RETURN TRUE FORCE
WHEN HaveSet AND NOT FlushPossible AND NOT OneCardStraightPossible RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_QualityPair##
WHEN HaveOverPair OR (HaveTopPair AND HaveBestKickerOrBetter) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_LowSPR##
WHEN PotSize > 0 AND StackSize <= (1.5 * PotSize) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_HighSPR##
WHEN PotSize > 0 AND StackSize >= (6 * PotSize) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_Air##
WHEN NOT f$DP_StrongMade AND NOT f$DP_GoodPair AND NOT f$DP_WeakPair AND NOT f$DP_AnyDraw AND NOT HavePocketPair RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_PreflopAggressor##
WHEN BotRaisedBeforeFlop RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_IP##
WHEN Position = Last RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_ReraisedPot##
// Opponent raise exists in a pot in which Hero also raised, or >1 opponent raises.
WHEN (BotRaisedBeforeFlop AND RaisesBeforeFlop) OR NumberOfRaisesBeforeFlop >= 2 RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_Commitment##
// Heads-up only; approximate effective-stack commitment from public OH symbols.
WHEN OpponentsLeft = 1 AND PotSize > 0 AND (StackSize <= (2 * PotSize) OR (OpponentStacksizeHeadsUp > 0 AND OpponentStacksizeHeadsUp <= (2 * PotSize))) RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE

##f$DP_RealPot##
WHEN PotSize >= 1 AND StackSize > 0 RETURN TRUE FORCE
WHEN Others RETURN FALSE FORCE


##f$preflop##
// Target is 6-max or fewer dealt; do not apply 6-max ranges to larger tables.
WHEN OpponentsAtTable > 5 AND AmountToCall = 0 Check FORCE
WHEN OpponentsAtTable > 5 Fold FORCE
// In all states: explicit choices, no implicit default.bot / no Beep.
// Hero faces a 4bet/5bet after having raised. First prefer strong value.
WHEN BotRaisedBeforeFlop AND Raises >= 2 AND listDP_5BET AND StackSize <= 110 RaiseMax FORCE
WHEN BotRaisedBeforeFlop AND Raises >= 2 AND listDP_4BET AND AmountToCall <= 20 AND StackSize > 110 Call FORCE
WHEN BotRaisedBeforeFlop AND Raises >= 2 Fold FORCE

// Hero opened or 3bet and now faces a re-raise.
WHEN BotRaisedBeforeFlop AND Raises = 1 AND AmountToCall > 0 AND listDP_5BET AND StackSize <= 35 RaiseMax FORCE
WHEN BotRaisedBeforeFlop AND Raises = 1 AND AmountToCall > 0 AND listDP_4BET AND StackSize >= 35 RaiseTo (TotalInvestedThisRound + (3 * AmountToCall)) FORCE
WHEN BotRaisedBeforeFlop AND Raises = 1 AND AmountToCall <= 10 AND StackSize >= 40 AND listDP_CALL_3BET Call FORCE
WHEN BotRaisedBeforeFlop AND Raises >= 1 Fold FORCE

// Facing an opening raise: 3bet for value first, selective late-position 3bet.
WHEN Raises = 1 AND NOT BotRaisedBeforeFlop AND listDP_3BET_VALUE AND AmountToCall <= 9 AND NOT InSmallBlind AND NOT InBigBlind RaiseTo (3.2 * AmountToCall + TotalInvestedThisRound) FORCE
WHEN Raises = 1 AND NOT BotRaisedBeforeFlop AND listDP_3BET_VALUE AND AmountToCall <= 9 AND (InSmallBlind OR InBigBlind) RaiseTo (3.8 * (AmountToCall + TotalInvestedThisRound)) FORCE
WHEN Raises = 1 AND NOT BotRaisedBeforeFlop AND FirstRaiserPosition <= 3 AND listDP_3BET_LATE AND randomhand < 0.42 AND AmountToCall <= 6 RaiseTo (3.5 * AmountToCall + TotalInvestedThisRound) FORCE
// Small blind: use 3bet-or-fold as the initial simplified defensive policy.
WHEN Raises = 1 AND InSmallBlind Fold FORCE
// BB defends wider versus CO/BTN/SB than LJ/HJ. Do not defend to huge sizing.
WHEN Raises = 1 AND InBigBlind AND AmountToCall <= 3.5 AND FirstRaiserPosition <= 3 AND listDP_BB_DEF_LATE Call FORCE
WHEN Raises = 1 AND InBigBlind AND AmountToCall <= 3 AND FirstRaiserPosition > 3 AND listDP_BB_DEF_EARLY Call FORCE
WHEN Raises = 1 AND InBigBlind Fold FORCE
// IP calling ranges (controlled by price). Avoid dominated offsuit trash.
WHEN Raises = 1 AND NOT InTheBlinds AND AmountToCall <= 4 AND StackSize >= 30 AND FirstRaiserPosition >= 4 AND listDP_CALL_EARLY Call FORCE
WHEN Raises = 1 AND NOT InTheBlinds AND AmountToCall <= 4 AND StackSize >= 30 AND FirstRaiserPosition <= 3 AND listDP_CALL_LATE Call FORCE
WHEN Raises >= 1 Fold FORCE

// Unopened pot. 2.5bb first-in as a practical default, 3bb SB OOP.
WHEN Raises = 0 AND Calls = 0 AND InMiddlePosition2 AND listDP_RFI_LJ RaiseTo 2.5 FORCE
WHEN Raises = 0 AND Calls = 0 AND InMiddlePosition3 AND listDP_RFI_HJ RaiseTo 2.5 FORCE
WHEN Raises = 0 AND Calls = 0 AND InCutOff AND listDP_RFI_CO RaiseTo 2.5 FORCE
WHEN Raises = 0 AND Calls = 0 AND InButton AND listDP_RFI_BTN RaiseTo 2.5 FORCE
WHEN Raises = 0 AND Calls = 0 AND InSmallBlind AND listDP_RFI_SB RaiseTo 3 FORCE
WHEN Raises = 0 AND Calls = 0 AND InBigBlind Check FORCE
WHEN Raises = 0 AND Calls = 0 AND AmountToCall = 0 Check FORCE
WHEN Raises = 0 AND Calls = 0 Fold FORCE

// Limped pots: isolation with value+playable hands, avoid over-limping garbage.
WHEN Raises = 0 AND Calls > 0 AND listDP_3BET_VALUE RaiseTo (3.5 + Calls) FORCE
WHEN Raises = 0 AND Calls > 0 AND NOT InBigBlind AND listDP_ISO AND StackSize >= 35 RaiseTo (3.5 + Calls) FORCE
WHEN Raises = 0 AND Calls > 0 AND InBigBlind AND listDP_ISO AND StackSize >= 35 RaiseTo (4 + Calls) FORCE
WHEN Raises = 0 AND Calls > 0 AND NOT InSmallBlind AND listDP_SMALL_CALL AND AmountToCall <= 1 AND StackSize >= 40 Call FORCE
WHEN Raises = 0 AND Calls > 0 AND InBigBlind Check FORCE
WHEN Raises = 0 AND Calls > 0 AND AmountToCall = 0 Check FORCE
WHEN Others Fold FORCE

##f$flop##
// Refuse to extrapolate this 6-max strategy to 7+ handed tables.
WHEN OpponentsAtTable > 5 AND AmountToCall = 0 Check FORCE
WHEN OpponentsAtTable > 5 Fold FORCE
// Facing a bet, check-raise or lead. Exception/super-premium BEFORE texture.
WHEN AmountToCall > 0 AND (HaveStraightFlush OR HaveQuads) AND StackSize > (2 * AmountToCall) RaisePot FORCE
WHEN AmountToCall > 0 AND f$DP_Premium AND (AmountToCall >= StackSize OR f$DP_LowSPR) Call FORCE
WHEN AmountToCall > 0 AND f$DP_Premium AND f$DP_HeadsUp AND AmountToCall <= (0.5 * PotSize) AND f$DP_DynamicFlop RaiseThreeFourthPot FORCE
WHEN AmountToCall > 0 AND f$DP_Premium Call FORCE

// Other strong made hands: nuanced by board, size, SPR, and multiway.
WHEN AmountToCall > 0 AND f$DP_StrongMade AND f$DP_HeadsUp AND f$DP_LowSPR AND NOT f$DP_Dangerous Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade AND NOT f$DP_Dangerous AND f$DP_HeadsUp AND AmountToCall <= (0.55 * PotSize) AND (HaveSet OR HaveTwoPair) RaiseThreeFourthPot FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade AND AmountToCall <= (0.8 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade AND f$DP_HeadsUp AND AmountToCall <= (1.1 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade Fold FORCE

// In reraised pots, value of TPTK/overpair rises when SPR is small.
WHEN AmountToCall > 0 AND f$DP_ReraisedPot AND f$DP_Commitment AND f$DP_QualityPair AND f$DP_HeadsUp AND AmountToCall <= (0.85 * PotSize) Call FORCE

// Strong draws: call price-sensitive; sometimes semibluff raise with range nut draws.
WHEN AmountToCall > 0 AND f$DP_NutDraw AND f$DP_HeadsUp AND NOT f$DP_IP AND AmountToCall <= (0.34 * PotSize) AND randomhand < 0.22 RaiseThreeFourthPot FORCE
WHEN AmountToCall > 0 AND f$DP_NutDraw AND AmountToCall <= (0.48 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_AnyDraw AND AmountToCall <= (0.26 * PotSize) Call FORCE

// Pair defenses; distinguish dry boards from the very dangerous texture and bet sizes.
WHEN AmountToCall > 0 AND f$DP_GoodPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND AmountToCall <= (0.48 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_GoodPair AND f$DP_HeadsUp AND AmountToCall <= (0.27 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_GoodPair AND f$DP_Multiway AND AmountToCall <= (0.28 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_WeakPair AND AmountToCall <= (0.16 * PotSize) AND f$DP_HeadsUp Call FORCE
WHEN AmountToCall > 0 Fold FORCE

// Not facing a bet. Made value and strong draws; avoid automatic air cbet on wet/multiway boards.
WHEN AmountToCall = 0 AND f$DP_Premium AND f$DP_Dangerous BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_Premium AND f$DP_Multiway BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_Premium BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade AND f$DP_Multiway AND f$DP_Dangerous Check FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade AND f$DP_Multiway BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade AND f$DP_Dangerous BetThirdPot FORCE
// Paired dry boards generally support smaller bets with a broad value range.
WHEN AmountToCall = 0 AND f$DP_StrongMade AND PairOnFlop AND NOT f$DP_DynamicFlop BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade AND f$DP_DynamicFlop BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade BetHalfPot FORCE

WHEN AmountToCall = 0 AND f$DP_ReraisedPot AND f$DP_HeadsUp AND f$DP_QualityPair AND NOT f$DP_Dangerous BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_GoodPair AND f$DP_Multiway AND f$DP_Dangerous Check FORCE
// Weak Ax on dry A-high boards can realize value by checking back.
WHEN AmountToCall = 0 AND f$DP_GoodPair AND AcePresentOnFlop AND NOT f$DP_QualityPair AND NOT f$DP_DynamicFlop Check FORCE
WHEN AmountToCall = 0 AND f$DP_GoodPair AND f$DP_DynamicFlop AND NOT f$DP_QualityPair Check FORCE
WHEN AmountToCall = 0 AND f$DP_GoodPair AND f$DP_PreflopAggressor AND f$DP_HeadsUp BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_GoodPair AND f$DP_HeadsUp AND f$DP_IP BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_GoodPair Check FORCE

WHEN AmountToCall = 0 AND f$DP_NutDraw AND f$DP_HeadsUp AND f$DP_PreflopAggressor AND randomhand < 0.65 Set user_DP_FlopDrawBet
WHEN AmountToCall = 0 AND f$DP_NutDraw AND f$DP_HeadsUp AND f$DP_PreflopAggressor AND randomhand < 0.65 BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_AnyDraw AND f$DP_HeadsUp AND f$DP_PreflopAggressor AND f$DP_IP AND randomhand < 0.40 Set user_DP_FlopDrawBet
WHEN AmountToCall = 0 AND f$DP_AnyDraw AND f$DP_HeadsUp AND f$DP_PreflopAggressor AND f$DP_IP AND randomhand < 0.40 BetThirdPot FORCE

WHEN AmountToCall = 0 AND f$DP_PreflopAggressor AND f$DP_HeadsUp AND f$DP_IP AND NOT f$DP_ReraisedPot AND NOT f$DP_DynamicFlop AND f$DP_Air AND randomhand < 0.48 Set user_DP_FlopAirBet
WHEN AmountToCall = 0 AND f$DP_PreflopAggressor AND f$DP_HeadsUp AND f$DP_IP AND NOT f$DP_DynamicFlop AND f$DP_Air AND randomhand < 0.48 BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_PreflopAggressor AND f$DP_HeadsUp AND f$DP_IP AND NOT f$DP_ReraisedPot AND f$DP_DynamicFlop AND f$DP_Air AND randomhand < 0.14 Set user_DP_FlopAirBet
WHEN AmountToCall = 0 AND f$DP_PreflopAggressor AND f$DP_HeadsUp AND f$DP_IP AND f$DP_DynamicFlop AND f$DP_Air AND randomhand < 0.14 BetThirdPot FORCE

WHEN AmountToCall = 0 Check FORCE
WHEN Others Fold FORCE

##f$turn##
// Refuse to extrapolate this 6-max strategy to 7+ handed tables.
WHEN OpponentsAtTable > 5 AND AmountToCall = 0 Check FORCE
WHEN OpponentsAtTable > 5 Fold FORCE
// Facing action. No texture may automatically fold the premium showdown classes.
WHEN AmountToCall > 0 AND (HaveStraightFlush OR HaveQuads) AND StackSize > (2 * AmountToCall) RaisePot FORCE
WHEN AmountToCall > 0 AND f$DP_Premium AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND AmountToCall <= (0.50 * PotSize) RaiseHalfPot FORCE
WHEN AmountToCall > 0 AND f$DP_Premium Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade AND f$DP_LowSPR AND NOT f$DP_Dangerous Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND AmountToCall <= (0.70 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade AND AmountToCall <= (0.50 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_StrongMade Fold FORCE
WHEN AmountToCall > 0 AND f$DP_ReraisedPot AND f$DP_Commitment AND f$DP_QualityPair AND NOT f$DP_Dangerous AND AmountToCall <= (0.68 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_NutDraw AND AmountToCall <= (0.32 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_AnyDraw AND AmountToCall <= (0.18 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_QualityPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND AmountToCall <= (0.36 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_GoodPair AND f$DP_HeadsUp AND AmountToCall <= (0.22 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_WeakPair AND f$DP_HeadsUp AND AmountToCall <= (0.10 * PotSize) Call FORCE
WHEN AmountToCall > 0 Fold FORCE

// When checked to, value/protection and controlled semibluffs. Avoid over-barreling air.
WHEN AmountToCall = 0 AND f$DP_Premium AND f$DP_Dangerous BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_Premium BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade AND f$DP_Dangerous AND f$DP_Multiway Check FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade AND f$DP_Dangerous BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_StrongMade BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_QualityPair AND f$DP_ReraisedPot AND f$DP_HeadsUp AND NOT f$DP_Dangerous BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_QualityPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND f$DP_PreflopAggressor BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_GoodPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND f$DP_IP BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_NutDraw AND f$DP_HeadsUp AND f$DP_PreflopAggressor AND randomhand < 0.55 Set user_DP_TurnDrawBet
WHEN AmountToCall = 0 AND f$DP_NutDraw AND f$DP_HeadsUp AND f$DP_PreflopAggressor AND randomhand < 0.55 BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_AnyDraw AND f$DP_HeadsUp AND f$DP_IP AND BotRaisedOnFlop AND randomhand < 0.30 Set user_DP_TurnDrawBet
WHEN AmountToCall = 0 AND f$DP_AnyDraw AND f$DP_HeadsUp AND f$DP_IP AND BotRaisedOnFlop AND randomhand < 0.30 BetHalfPot FORCE
// Delayed c-bet if we checked flop, rarely bluff dry boards in position.
WHEN AmountToCall = 0 AND BotCheckedOnFlop AND f$DP_PreflopAggressor AND f$DP_HeadsUp AND f$DP_IP AND f$DP_Air AND NOT f$DP_Dangerous AND randomhand < 0.15 BetThirdPot FORCE
WHEN AmountToCall = 0 Check FORCE
WHEN Others Fold FORCE

##f$river##
// Refuse to extrapolate this 6-max strategy to 7+ handed tables.
WHEN OpponentsAtTable > 5 AND AmountToCall = 0 Check FORCE
WHEN OpponentsAtTable > 5 Fold FORCE
// Strong made hands: board texture alone is NEVER a fold reason.
// Absolute nuts (including non-board straight flush/quads) can raise for value.
WHEN AmountToCall > 0 AND (HaveStraightFlush OR HaveQuads) AND NOT NutsOnBoard AND StackSize > (2 * AmountToCall) RaisePot FORCE
WHEN AmountToCall > 0 AND (HaveStraightFlush OR HaveQuads) Call FORCE
WHEN AmountToCall > 0 AND HaveFullHouse AND NOT FullHouseOnBoard AND HaveNuts AND AmountToCall <= (0.6 * PotSize) AND f$DP_HeadsUp RaiseHalfPot FORCE
WHEN AmountToCall > 0 AND HaveFullHouse AND NOT FullHouseOnBoard Call FORCE
WHEN AmountToCall > 0 AND f$DP_Premium Call FORCE

// Other made hands. Avoid blindly calling large polar bets on paired/four-flush runouts.
WHEN AmountToCall > 0 AND HaveFlush AND NOT FlushOnBoard AND HaveNutFlush AND NOT PairOnBoard AND AmountToCall <= (1.1 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND HaveFlush AND NOT FlushOnBoard AND HaveSecondNutFlush AND AmountToCall <= (0.8 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND HaveFlush AND NOT FlushOnBoard AND NOT PairOnBoard AND AmountToCall <= (0.42 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND HaveStraight AND NOT StraightOnBoard AND NOT FlushPossible AND NOT PairOnBoard AND AmountToCall <= (0.62 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND HaveStraight AND NOT StraightOnBoard AND AmountToCall <= (0.28 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND (HaveSet OR HaveTrips) AND NOT f$DP_Dangerous AND AmountToCall <= (0.48 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND HaveTwoPair AND NOT f$DP_Dangerous AND f$DP_HeadsUp AND AmountToCall <= (0.35 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_QualityPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND AmountToCall <= (0.28 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND f$DP_GoodPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND AmountToCall <= (0.14 * PotSize) Call FORCE
WHEN AmountToCall > 0 AND HaveTwoPair AND f$DP_HeadsUp AND AmountToCall <= (0.15 * PotSize) Call FORCE
WHEN AmountToCall > 0 Fold FORCE

// River value, with checks to protect medium hands and avoid blockered nonsense.
WHEN AmountToCall = 0 AND (HaveStraightFlush OR HaveQuads) AND NOT NutsOnBoard BetPot FORCE
WHEN AmountToCall = 0 AND HaveFullHouse AND NOT FullHouseOnBoard AND NOT OneCardStraightFlushPossible BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND HaveFullHouse AND NOT FullHouseOnBoard BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_Premium AND NOT NutsOnBoard BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND HaveNutFlush AND NOT PairOnBoard AND NOT FlushOnBoard BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND HaveFlush AND NOT FlushOnBoard AND NOT PairOnBoard AND NOT OneCardFlushPossible BetHalfPot FORCE
WHEN AmountToCall = 0 AND HaveStraight AND NOT StraightOnBoard AND NOT PairOnBoard AND NOT FlushPossible BetHalfPot FORCE
WHEN AmountToCall = 0 AND (HaveSet OR HaveTwoPair) AND NOT f$DP_Dangerous AND f$DP_HeadsUp BetHalfPot FORCE
WHEN AmountToCall = 0 AND f$DP_QualityPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND f$DP_PreflopAggressor AND f$DP_ReraisedPot AND randomhand < 0.60 BetThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_QualityPair AND f$DP_HeadsUp AND NOT f$DP_Dangerous AND f$DP_PreflopAggressor AND NOT f$DP_HighSPR AND randomhand < 0.65 BetThirdPot FORCE

// Selected missed-draw bluffs from credible prior betting lines, HU/IP only.
WHEN AmountToCall = 0 AND f$DP_Air AND f$DP_HeadsUp AND f$DP_IP AND f$DP_PreflopAggressor AND user_DP_TurnDrawBet AND randomhand < 0.21 BetTwoThirdPot FORCE
WHEN AmountToCall = 0 AND f$DP_Air AND f$DP_HeadsUp AND f$DP_IP AND f$DP_PreflopAggressor AND user_DP_FlopDrawBet AND randomhand < 0.12 BetHalfPot FORCE

WHEN AmountToCall = 0 Check FORCE
WHEN Others Fold FORCE
